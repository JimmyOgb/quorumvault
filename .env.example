# Canton Network Environment Configuration
# Target: HackCanton DevNet (or localnet / testnet)

# Network identifier (devnet, localnet, testnet)
NEXT_PUBLIC_CANTON_NETWORK=devnet

# Canton Ledger JSON API endpoint
# HackCanton DevNet participant endpoint:
NEXT_PUBLIC_CANTON_LEDGER_API=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services

# Canton API version (v2 for Canton 3.5+ / HackCanton DevNet)
NEXT_PUBLIC_CANTON_API_VERSION=v2

# Daml Package ID for QuorumVault / Vault package
# Verified vetted on HackCanton DevNet:
NEXT_PUBLIC_VAULT_PACKAGE_ID=c8ac685dd4671ced2983869ef6a118d9698a4280db05fd0e6eef6a67cacdf249
