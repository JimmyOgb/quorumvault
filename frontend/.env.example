# Canton Network Environment Configuration
# Target: Canton LocalNet (or devnet / testnet)

# Network identifier (e.g. localnet, devnet, testnet)
NEXT_PUBLIC_CANTON_NETWORK=localnet

# Canton Ledger JSON API endpoint
# LocalNet default JSON API URL (typically http://localhost:7575 or http://127.0.0.1:7575)
NEXT_PUBLIC_CANTON_LEDGER_API=http://localhost:7575

# Optional Canton Scan / Explorer API endpoint (if deployed on network)
NEXT_PUBLIC_CANTON_SCAN_API=http://localhost:4000

# Daml Package ID for QuorumVault / Vault package
# Obtain this by building the DAR: dpm build
# Then inspect package ID via: dpm inspect-dar .daml/dist/quorumvault-0.1.0.dar
# Or read from ledger uploaded packages
NEXT_PUBLIC_VAULT_PACKAGE_ID=
